# Copy to .env.local (git-ignored) and fill in values.
# Only EXPO_PUBLIC_* variables are embedded into the client bundle. They must NEVER be secrets.

# Supabase (M07+). Local dev values come from `npx supabase status`.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Provider mode: "mock" (default, clearly labeled) or "real" (requires approved provider configuration)
EXPO_PUBLIC_PROVIDER_MODE=mock

# Server-side only (Supabase Edge Functions / CI secrets). Never prefix with EXPO_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
