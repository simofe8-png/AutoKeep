{
  "expo": {
    "name": "AutoKeep",
    "slug": "autokeep",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "autokeep",
    "userInterfaceStyle": "light",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.autokeep.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "AutoKeep משתמשת במצלמה רק כשאתם בוחרים לצלם רישיון רכב או חשבונית.",
        "NSPhotoLibraryUsageDescription": "AutoKeep ניגשת לתמונה שבחרתם בלבד, כדי לצרף רישיון רכב או חשבונית.",
        "ExpoLocalization_forcesRTL": true
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#02306E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.moshenahum.autokeep",
      "softwareKeyboardLayoutMode": "resize",
      "versionCode": 1,
      "permissions": ["android.permission.CAMERA", "android.permission.POST_NOTIFICATIONS"],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "com.google.android.c2dm.permission.RECEIVE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "extraMavenRepos": ["https://jitpack.io"]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#02306E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220
        }
      ],
      [
        "expo-localization",
        {
          "forcesRTL": true
        }
      ],
      "expo-sqlite",
      "expo-secure-store",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "cameraPermission": "AutoKeep משתמשת במצלמה רק כשאתם בוחרים לצלם רישיון רכב או חשבונית.",
          "photosPermission": "AutoKeep ניגשת לתמונה שבחרתם בלבד, כדי לצרף רישיון רכב או חשבונית.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#1B64D6"
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "d243d46c-a4fb-4232-b17d-ae39b158b3a8"
      }
    },
    "owner": "vr47252"
  }
}
